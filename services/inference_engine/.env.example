# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Which provider the engine uses: mock | anthropic | azure_foundry
SPARKLEME_PROVIDER=mock

# --- Anthropic (reachable from the dev sandbox) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Azure AI Foundry (your models; reachable from your infra) ---
# One endpoint serves all models; pick the model per run via SPARKLEME_AZURE_MODEL.
AZURE_FOUNDRY_ENDPOINT=https://sparkleme-resource.services.ai.azure.com/api/projects/sparkleme
AZURE_FOUNDRY_API_KEY=
# vision-capable: grok-4.3 | gpt-5.6-sol | gpt-5.4 | gpt-5.6-terra ; text-only: Kimi-K2.6
SPARKLEME_AZURE_MODEL=gpt-5.6-sol

# Where client images live: <IMAGES_ROOT>/<client_id>/*.jpeg  (or a single <client_id>.pdf)
SPARKLEME_IMAGES_ROOT=./fixtures/cases
